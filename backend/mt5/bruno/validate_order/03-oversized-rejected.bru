meta {
  name: Validate BUY 1000 lots (expect ok=false)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/validate_order
  body: json
  auth: none
}

body:json {
  {
    "symbol": "{{symbol}}",
    "volume": 1000,
    "type": "BUY"
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  test("ok is false", function () {
    expect(res.body.ok).to.equal(false);
    expect(res.body.comment).to.be.a("string");
  });
}
